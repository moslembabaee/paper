{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:mcp",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "mcp": "node ../mcp-server/bin/paper-mcp.mjs",
    "test:mcp": "npm --prefix ../mcp-server test",
    "lint": "oxlint",
    "preview": "vite preview",
    "bridge": "node ../mcp-server/dist/mcp/bridge-cli.js"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.81",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
